// Colors and metrics mirroring opencode-mobile's React Native styles, in light and dark variants.
import { Palette } from "std-widgets.slint";

export global Theme {
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> preference: 0;
    out property <bool> dark: preference == 2 ? true : preference == 1 ? false : Palette.color-scheme == ColorScheme.dark;

    out property <color> bg: dark ? #0a0a0a : #ffffff;
    out property <color> surface: dark ? #1a1a1a : #f5f5f5;
    out property <color> surface-2: dark ? #2a2a2a : #e5e5e5;
    out property <color> sheet: dark ? #1a1a1a : #ffffff;
    out property <color> border: dark ? #1a1a1a : #e5e5e5;
    out property <color> hairline: dark ? #2a2a2a : #e5e5e5;
    out property <color> text: dark ? #ffffff : #0a0a0a;
    out property <color> text-2: dark ? #888888 : #666666;
    out property <color> muted: dark ? #666666 : #999999;
    out property <color> faint: dark ? #444444 : #cccccc;

    out property <color> accent: #8b5cf6;
    out property <color> accent-strong: dark ? #a78bfa : #6d28d9;
    out property <color> accent-soft: dark ? #1a1a2e : #f5f3ff;
    out property <color> accent-row: dark ? #1f1a2e : #f5f3ff;

    out property <color> primary: dark ? #ffffff : #0a0a0a;
    out property <color> on-primary: dark ? #0a0a0a : #ffffff;

    out property <color> green: #22c55e;
    out property <color> red: #ef4444;
    out property <color> amber: #f59e0b;

    out property <color> bubble-user: dark ? #1a1a1a : #f5f5f5;
    out property <color> bubble-assistant: dark ? #1a1a2e : #f0f0ff;
    out property <color> tag: dark ? #2a2a2a : #e5e5e5;

    out property <color> card: dark ? #2a2a2a : #ffffff;
    out property <color> card-border: dark ? #3a3a3a : #f0f0f0;
    out property <color> code-bg: dark ? #1a1a1a : #f8f8f8;
    out property <color> code-text: dark ? #e5e5e5 : #0a0a0a;

    out property <color> warn-bg: dark ? #1a1a0a : #fffbeb;
    out property <color> warn-border: dark ? #333300 : #fef3c7;
    out property <color> warn-title: dark ? #f59e0b : #92400e;
    out property <color> warn-text: dark ? #d4a574 : #78350f;

    out property <color> err-bg: dark ? #3b1212 : #fef2f2;
    out property <color> err-border: dark ? #7f1d1d : #fecaca;
    out property <color> err-text: dark ? #fca5a5 : #b91c1c;

    out property <color> add-bg: dark ? #052e16 : #dcfce7;
    out property <color> add-text: #16a34a;
    out property <color> del-bg: dark ? #2a0a0a : #fee2e2;
    out property <color> del-text: #dc2626;

    out property <string> mono: "Consolas";
}


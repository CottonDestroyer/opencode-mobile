import { Theme, Icons } from "theme.slint";
import { State, Actions, ProviderRow } from "globals.slint";
import { Icon, IconButton, Button } from "components.slint";

component ProviderItem inherits Rectangle {
    in property <ProviderRow> data;
    callback remove(string, string);
    height: 68px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Theme.surface;
            Icon {
                source: Icons.cloud;
                size: 18px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.green;
                }
                Text {
                    text: root.data.name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.data.source + " · " + root.data.models;
                font-size: 12px;
                color: Theme.text-2;
                overflow: elide;
            }
        }
        if root.data.removable: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.trash;
            tint: Theme.red;
            clicked => {
                root.remove(root.data.id, root.data.name);
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component ProvidersScreen inherits Rectangle {
    callback confirm-remove(string, string);
    background: Theme.bg;
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            width: parent.width;
            padding-top: 16px;
            padding-bottom: 96px;
            spacing: 8px;
            alignment: start;

            // OpenCode Zen: the anonymous free tier works without a key.
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Rectangle {
                    background: Theme.accent-soft;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.3);
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Icon {
                                source: Icons.sparkles;
                                size: 18px;
                                color: Theme.accent;
                            }
                            Text {
                                text: "OpenCode Zen";
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                border-radius: 8px;
                                background: State.zen-has-key ? Theme.green.with-alpha(0.15) : Theme.accent.with-alpha(0.15);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    Text {
                                        text: State.zen-has-key ? "API key" : "Free";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: State.zen-has-key ? Theme.green : Theme.accent-strong;
                                    }
                                }
                            }
                        }
                        Text {
                            text: State.zen-status;
                            font-size: 13px;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                        if !State.zen-has-key: HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;
                            Button {
                                kind: 3;
                                text: "Add OpenCode key";
                                icon: Icons.key;
                                has-icon: true;
                                clicked => {
                                    Actions.choose-key-provider("opencode");
                                }
                            }
                        }
                    }
                }
            }

            Text {
                x: 16px;
                text: "CONNECTED PROVIDERS";
                font-size: 12px;
                font-weight: 700;
                color: Theme.muted;
                letter-spacing: 0.5px;
            }
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Rectangle {
                    background: Theme.dark ? #111111 : #ffffff;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        for p in State.provider-rows: ProviderItem {
                            data: p;
                            remove(id, name) => {
                                root.confirm-remove(id, name);
                            }
                        }
                        if State.provider-rows.length == 0: VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            Text {
                                text: "No API keys yet.";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text;
                            }
                            Text {
                                text: "Tap + to add Anthropic, OpenAI, Google, OpenRouter…";
                                font-size: 13px;
                                color: Theme.text-2;
                                overflow: elide;
                            }
                            Text {
                                text: "Keys in environment variables are detected automatically.";
                                font-size: 13px;
                                color: Theme.text-2;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            Text {
                x: 16px;
                width: parent.width - 32px;
                text: "Keys are stored in " + State.data-dir + "\\auth.json, shared with the opencode CLI.";
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }

    Rectangle {
        x: root.width - self.width - 20px;
        y: root.height - self.height - 20px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: Theme.primary;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000040;
        Icon {
            source: Icons.add;
            size: 28px;
            color: Theme.on-primary;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Actions.open-add-key();
            }
        }
    }
}

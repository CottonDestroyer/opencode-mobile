import { Theme, Icons } from "theme.slint";
import { State, Actions } from "globals.slint";
import { Icon, IconButton, Sheet, Modal, Button, Field, PickerList, Divider } from "components.slint";
import { SessionsScreen } from "sessions.slint";
import { ChatScreen } from "chat.slint";
import { ProvidersScreen } from "providers.slint";
import { SettingsScreen } from "settings.slint";

export { State, Actions, Theme }

component TabButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 24px;
                color: root.active ? Theme.text : Theme.muted;
            }
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.text : Theme.muted;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component DirOption inherits Rectangle {
    in property <image> icon;
    in property <string> name;
    in property <string> path;
    in property <bool> current;
    in property <bool> arrow;
    callback clicked();
    height: 56px;
    border-radius: 10px;
    background: current ? Theme.accent-row : ta.has-hover ? Theme.surface : (Theme.dark ? #111111 : #fafafa);
    border-width: current ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.4);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 18px;
            color: root.current ? Theme.accent : Theme.text-2;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                font-size: 14px;
                font-weight: 600;
                color: root.current ? Theme.accent-strong : Theme.text;
                overflow: elide;
            }
            if root.path != "": Text {
                text: root.path;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if root.current: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.check-circle;
            size: 18px;
            color: Theme.accent;
        }
        if root.arrow: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.chevron-forward;
            size: 16px;
            color: Theme.muted;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The entire UI. AppWindow sizes it to the safe area, so `root.width/height` here is the usable area.
component AppContent inherits Rectangle {
    // Overlays owned by this component rather than by Rust.
    // 0 = closed, 1 = switch project, 2 = new session in a chosen directory.
    property <int> dir-sheet: 0;
    property <string> custom-dir;
    property <string> action-id;
    property <string> action-title;
    property <bool> actions-open;
    property <bool> rename-open;
    property <string> rename-text;
    property <bool> delete-open;
    property <bool> remove-key-open;
    property <string> remove-key-id;
    property <string> remove-key-name;
    property <string> key-text;
    property <bool> key-visible;

    public function focus-chat-input() {
        chat.focus-input();
    }

    out property <bool> overlay-open: root.dir-sheet != 0 || root.actions-open || root.rename-open || root.delete-open || root.remove-key-open || State.select-open || State.model-picker-open || State.variant-picker-open || State.add-key-open || State.confirm-open;

    // Handles Android Back: closes the topmost overlay, else leaves the chat, else returns to the
    // Sessions tab. Returns false when there is nothing left to go back to, so the activity closes.
    public function handle-back() -> bool {
        if State.locked {
            return false;
        }
        if State.confirm-open {
            State.confirm-open = false;
            return true;
        }
        if root.remove-key-open || root.delete-open || root.rename-open || root.actions-open {
            root.remove-key-open = false;
            root.delete-open = false;
            root.rename-open = false;
            root.actions-open = false;
            return true;
        }
        if State.select-open || State.variant-picker-open || State.model-picker-open {
            State.select-open = false;
            State.variant-picker-open = false;
            State.model-picker-open = false;
            return true;
        }
        if State.add-key-open {
            State.add-key-open = false;
            root.key-text = "";
            return true;
        }
        if root.dir-sheet != 0 {
            root.dir-sheet = 0;
            return true;
        }
        if State.in-chat {
            if State.show-info {
                State.show-info = false;
            } else {
                Actions.back();
            }
            return true;
        }
        if State.tab != 0 {
            State.tab = 0;
            Actions.refresh-sessions();
            return true;
        }
        return false;
    }

    VerticalLayout {
        if !State.in-chat: Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                Text {
                    text: State.tab == 0 ? "Sessions" : State.tab == 1 ? "Providers" : "Settings";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if State.tab == 0: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.refresh;
                    clicked => {
                        Actions.refresh-sessions();
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            if !State.in-chat && State.tab == 0: SessionsScreen {
                open-dir-sheet => {
                    root.custom-dir = "";
                    root.dir-sheet = 1;
                }
                open-new-modal => {
                    root.custom-dir = "";
                    root.dir-sheet = 2;
                }
                session-actions(id, title) => {
                    root.action-id = id;
                    root.action-title = title;
                    root.actions-open = true;
                }
            }
            if !State.in-chat && State.tab == 1: ProvidersScreen {
                confirm-remove(id, name) => {
                    root.remove-key-id = id;
                    root.remove-key-name = name;
                    root.remove-key-open = true;
                }
            }
            if !State.in-chat && State.tab == 2: SettingsScreen { }
            chat := ChatScreen {
                visible: State.in-chat;
            }
        }

        if !State.in-chat: Rectangle {
            height: 60px;
            background: Theme.bg;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                TabButton {
                    icon: Icons.chats;
                    label: "Sessions";
                    active: State.tab == 0;
                    clicked => {
                        State.tab = 0;
                        Actions.refresh-sessions();
                    }
                }
                TabButton {
                    icon: Icons.key;
                    label: "Providers";
                    active: State.tab == 1;
                    clicked => {
                        State.tab = 1;
                    }
                }
                TabButton {
                    icon: Icons.settings;
                    label: "Settings";
                    active: State.tab == 2;
                    clicked => {
                        State.tab = 2;
                    }
                }
            }
        }
    }

    // Project directory sheet (switch project / new session elsewhere)
    if root.dir-sheet != 0: Sheet {
        title: root.dir-sheet == 1 ? "Switch project" : "New Session";
        fraction: 0.8;
        close => {
            root.dir-sheet = 0;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: dcol.preferred-height;
            dcol := VerticalLayout {
                width: parent.width;
                padding: 16px;
                padding-top: 4px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: "CURRENT PROJECT";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.muted;
                }
                DirOption {
                    icon: Icons.folder;
                    name: State.project-name;
                    path: State.project-path;
                    current: root.dir-sheet == 1;
                    arrow: root.dir-sheet == 2;
                    clicked => {
                        if root.dir-sheet == 2 {
                            Actions.new-session();
                        }
                        root.dir-sheet = 0;
                    }
                }
                if State.recent-dirs.length > 0: Text {
                    text: "RECENT PROJECTS";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.muted;
                }
                for d in State.recent-dirs: DirOption {
                    icon: Icons.folder-outline;
                    name: d.name;
                    path: d.path;
                    clicked => {
                        if root.dir-sheet == 1 {
                            Actions.switch-dir(d.path);
                        } else {
                            Actions.new-session-in(d.path);
                        }
                        root.dir-sheet = 0;
                    }
                }
                DirOption {
                    icon: Icons.folder-open;
                    name: "Browse folders…";
                    path: "Pick a folder on this device";
                    arrow: true;
                    clicked => {
                        if root.dir-sheet == 1 {
                            Actions.browse-switch-dir();
                        } else {
                            Actions.browse-new-session();
                        }
                        root.dir-sheet = 0;
                    }
                }
                Text {
                    text: "OR ENTER A PATH";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.muted;
                }
                Field {
                    text <=> root.custom-dir;
                    placeholder: "/storage/emulated/0/project";
                    mono: true;
                    accepted => {
                        if root.custom-dir != "" {
                            if root.dir-sheet == 1 {
                                Actions.switch-dir(root.custom-dir);
                            } else {
                                Actions.new-session-in(root.custom-dir);
                            }
                            root.dir-sheet = 0;
                        }
                    }
                }
                Button {
                    text: root.custom-dir == "" ? (root.dir-sheet == 1 ? "Done" : "Create Session") : (root.dir-sheet == 1 ? "Open this folder" : "Create in this folder");
                    clicked => {
                        if root.custom-dir != "" {
                            if root.dir-sheet == 1 {
                                Actions.switch-dir(root.custom-dir);
                            } else {
                                Actions.new-session-in(root.custom-dir);
                            }
                        } else if root.dir-sheet == 2 {
                            Actions.new-session();
                        }
                        root.dir-sheet = 0;
                    }
                }
            }
        }
    }

    // Session actions (long press)
    if root.actions-open: Modal {
        title: root.action-title;
        close => {
            root.actions-open = false;
        }
        Button {
            kind: 1;
            text: "Rename";
            icon: Icons.pencil;
            has-icon: true;
            clicked => {
                root.actions-open = false;
                root.rename-text = root.action-title;
                root.rename-open = true;
            }
        }
        Button {
            kind: 2;
            text: "Delete";
            icon: Icons.trash;
            has-icon: true;
            clicked => {
                root.actions-open = false;
                root.delete-open = true;
            }
        }
        Button {
            kind: 1;
            text: "Cancel";
            clicked => {
                root.actions-open = false;
            }
        }
    }

    if root.rename-open: Modal {
        title: "Rename Session";
        close => {
            root.rename-open = false;
        }
        rf := Field {
            text <=> root.rename-text;
            init => {
                self.focus-input();
                self.select-all();
            }
            accepted => {
                if root.rename-text != "" {
                    Actions.rename-session(root.action-id, root.rename-text);
                    root.rename-open = false;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                kind: 1;
                text: "Cancel";
                clicked => {
                    root.rename-open = false;
                }
            }
            Button {
                horizontal-stretch: 1;
                text: "Save";
                enabled: root.rename-text != "";
                clicked => {
                    Actions.rename-session(root.action-id, root.rename-text);
                    root.rename-open = false;
                }
            }
        }
    }

    if root.delete-open: Modal {
        title: "Delete Session";
        close => {
            root.delete-open = false;
        }
        Text {
            text: "Delete \"" + root.action-title + "\"? This also removes its subagent sessions and can't be undone.";
            font-size: 14px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                kind: 1;
                text: "Cancel";
                clicked => {
                    root.delete-open = false;
                }
            }
            Button {
                horizontal-stretch: 1;
                kind: 2;
                text: "Delete";
                clicked => {
                    Actions.delete-session(root.action-id);
                    root.delete-open = false;
                }
            }
        }
    }

    // Model picker
    if State.model-picker-open: Sheet {
        title: "Select Model";
        fraction: 0.8;
        close => {
            State.model-picker-open = false;
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            Field {
                placeholder: "Search models…";
                init => {
                    self.focus-input();
                }
                edited(t) => {
                    Actions.model-search(t);
                }
            }
        }
        PickerList {
            vertical-stretch: 1;
            rows: State.model-rows;
            picked(v) => {
                Actions.pick-model(v);
                State.model-picker-open = false;
            }
        }
    }

    // Variant (reasoning effort) picker
    if State.variant-picker-open: Sheet {
        title: "Reasoning Effort";
        fraction: 0.5;
        close => {
            State.variant-picker-open = false;
        }
        PickerList {
            vertical-stretch: 1;
            rows: State.variant-rows;
            picked(v) => {
                Actions.pick-variant(v);
                State.variant-picker-open = false;
            }
        }
    }

    // Add API key
    if State.add-key-open: Sheet {
        title: State.add-key-provider == "" ? "Add API Key" : State.add-key-provider-name;
        fraction: 0.8;
        close => {
            State.add-key-open = false;
            root.key-text = "";
        }
        if State.add-key-provider == "": HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            Field {
                placeholder: "Search providers…";
                init => {
                    self.focus-input();
                }
                edited(t) => {
                    Actions.catalog-search(t);
                }
            }
        }
        if State.add-key-provider == "": PickerList {
            vertical-stretch: 1;
            rows: State.catalog-rows;
            picked(v) => {
                root.key-text = "";
                Actions.choose-key-provider(v);
            }
        }
        if State.add-key-provider != "": VerticalLayout {
            vertical-stretch: 1;
            padding: 16px;
            padding-top: 4px;
            spacing: 12px;
            alignment: start;
            Text {
                text: "Paste your API key. It is saved to auth.json on this device and used directly by the agent.";
                font-size: 13px;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                Field {
                    text <=> root.key-text;
                    placeholder: "API key";
                    password: !root.key-visible;
                    mono: true;
                    init => {
                        self.focus-input();
                    }
                    accepted => {
                        if root.key-text != "" {
                            Actions.save-key(State.add-key-provider, root.key-text);
                            root.key-text = "";
                        }
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.key-visible ? Icons.eye-off : Icons.eye;
                    clicked => {
                        root.key-visible = !root.key-visible;
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    horizontal-stretch: 1;
                    kind: 1;
                    text: "Back";
                    clicked => {
                        root.key-text = "";
                        Actions.open-add-key();
                    }
                }
                Button {
                    horizontal-stretch: 1;
                    text: "Save Key";
                    enabled: root.key-text != "";
                    clicked => {
                        Actions.save-key(State.add-key-provider, root.key-text);
                        root.key-text = "";
                    }
                }
            }
        }
    }

    if root.remove-key-open: Modal {
        title: "Remove " + root.remove-key-name + " key?";
        close => {
            root.remove-key-open = false;
        }
        Text {
            text: "The key is deleted from auth.json. Sessions using this provider will need another model.";
            font-size: 14px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                kind: 1;
                text: "Cancel";
                clicked => {
                    root.remove-key-open = false;
                }
            }
            Button {
                horizontal-stretch: 1;
                kind: 2;
                text: "Remove";
                clicked => {
                    Actions.remove-key(root.remove-key-id);
                    root.remove-key-open = false;
                }
            }
        }
    }

    // Full-message text selection
    if State.select-open: Sheet {
        title: "Select Text";
        fraction: 0.85;
        close => {
            State.select-open = false;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: sel.preferred-height + 32px;
            sel := TextInput {
                x: 16px;
                width: parent.width - 32px;
                text: State.select-text;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                font-size: 14px;
                color: Theme.text;
                selection-background-color: Theme.accent.with-alpha(0.35);
                init => {
                    self.focus();
                    self.select-all();
                }
            }
        }
        HorizontalLayout {
            padding: 16px;
            Button {
                text: "Copy all";
                icon: Icons.copy;
                has-icon: true;
                clicked => {
                    Actions.copy-text(State.select-text);
                }
            }
        }
    }

    // Confirmation dialog
    if State.confirm-open: Modal {
        title: State.confirm-title;
        close => {
            State.confirm-open = false;
        }
        Text {
            text: State.confirm-text;
            font-size: 14px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                horizontal-stretch: 1;
                kind: 1;
                text: "Cancel";
                clicked => {
                    State.confirm-open = false;
                }
            }
            Button {
                horizontal-stretch: 1;
                kind: 2;
                text: State.confirm-button;
                clicked => {
                    State.confirm-open = false;
                    Actions.confirm-accepted();
                }
            }
        }
    }

    // Toast
    if State.toast != "": Rectangle {
        x: 24px;
        width: root.width - 48px;
        y: root.height - self.height - (State.in-chat ? 140px : 84px);
        height: tl.preferred-height;
        border-radius: 10px;
        background: State.toast-error ? #991b1b : (Theme.dark ? #2a2a2a : #0a0a0a);
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000040;
        tl := HorizontalLayout {
            padding: 12px;
            Text {
                text: State.toast;
                color: #ffffff;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }

    // App lock
    if State.locked: Rectangle {
        background: Theme.bg;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding: 32px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    source: Icons.lock;
                    size: 64px;
                    color: Theme.faint;
                }
            }
            Text {
                text: "OpenCode is locked";
                font-size: 18px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: "Use your fingerprint, face or screen lock to continue";
                font-size: 14px;
                color: Theme.text-2;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Button {
                    text: "Unlock";
                    icon: Icons.finger-print;
                    has-icon: true;
                    clicked => {
                        Actions.unlock();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "OpenCode Mobile";
    background: Theme.bg;
    default-font-size: 14px;

    // The activity draws edge to edge, so keep the content clear of the system bars and the soft
    // keyboard.
    property <length> keyboard-inset: self.virtual-keyboard-size.height > 0 ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;
    property <length> bottom-inset: max(self.safe-area-insets.bottom, self.keyboard-inset);

    public function focus-chat-input() {
        content.focus-chat-input();
    }

    // Android delivers Back as `Key.Back` to the focused item, and an unhandled one finishes the
    // activity. `capture-key-pressed` sees it even while a text field has focus; otherwise the
    // FocusScope itself must hold focus. Focus is lost whenever the focused field disappears (leaving
    // the chat, closing a sheet), so it's handed back to the FocusScope at those points.
    forward-focus: keys;
    property <bool> in-chat: State.in-chat;
    property <bool> overlay-open: content.overlay-open;
    changed in-chat => {
        if !self.in-chat {
            keys.focus();
        }
    }
    changed overlay-open => {
        if !self.overlay-open {
            keys.focus();
        }
    }
    keys := FocusScope {
        // Don't take focus from the composer when empty space is tapped.
        focus-on-click: false;
        capture-key-pressed(ev) => {
            if ev.text == Key.Back && content.handle-back() {
                return accept;
            }
            return reject;
        }
        content := AppContent {
            x: root.safe-area-insets.left;
            y: root.safe-area-insets.top;
            width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
            height: root.height - root.safe-area-insets.top - root.bottom-inset;
        }
    }
}
